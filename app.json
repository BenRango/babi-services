{
  "expo": {
    "name": "babi-services",
    "slug": "babi-services",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo/BabiService_logo.png",
    "scheme": "babiservices",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#241A12",
        "foregroundImage": "./assets/images/logo/BabiService_logo.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.johan404brain.babiservices"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2B2B2B",
          "image": "./assets/images/logo/BabiService_logo.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Autoriser BabiServices à accéder au micro pour enregistrer des notes vocales."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Autoriser BabiServices à accéder à vos photos pour illustrer votre demande.",
          "cameraPermission": "Autoriser BabiServices à accéder à l'appareil photo pour illustrer votre demande."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d9a049d8-cf41-4083-8a59-820491be18cd"
      }
    }
  }
}
